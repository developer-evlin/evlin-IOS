# Supabase configuration
SUPABASE_URL=your-supabase-url
SUPABASE_KEY=your-supabase-service-role-key

# Database connection
# Example: postgresql://postgres.xxxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=your-supabase-db-url

# Cloudflare R2 configuration
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=evlin-submissions

# Gemini — powers chat, memory and ranking video suggestions.
# Note: a Vertex AI Express *trial* key will be rejected with
# API_KEY_SERVICE_BLOCKED however valid it looks. Use a key whose API
# restrictions include generativelanguage.googleapis.com.
GEMINI_API_KEY=your-gemini-api-key


# YouTube Data API v3 — searches for the chat's video suggestions. Without it
# the assistant says video search isn't set up.
YOUTUBE_API_KEY=your-youtube-data-api-key

# Auth. One long random secret; email codes are HMAC'd with a key derived
# from it, and stored Apple tokens are encrypted with another. Set it once:
# changing it voids codes in flight and stored Apple tokens.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=your-long-random-secret

# Email sign-up codes go out through Resend's HTTPS API (Render's free plan
# blocks SMTP). EMAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=Evlin <no-reply@your-verified-domain>

# Sign in with Apple. Identity tokens are checked against APPLE_BUNDLE_ID.
# The other three come from the Sign in with Apple key (.p8) in the Apple
# Developer portal and are only needed to revoke Apple sign-in when an
# account is deleted. APPLE_PRIVATE_KEY is the .p8 file's contents; "\n"
# escapes are accepted for a single-line value.
APPLE_BUNDLE_ID=com.evlin.app
APPLE_TEAM_ID=your-apple-team-id
APPLE_KEY_ID=your-sign-in-with-apple-key-id
APPLE_PRIVATE_KEY=contents-of-the-p8-file
